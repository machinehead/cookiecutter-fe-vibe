{
  "name": "{{ cookiecutter.project_slug }}-workspace",
  "version": "0.1.0",
  "packageManager": "pnpm@10.10.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @local/webapp dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @local/webapp start",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "prepare": "husky",
    "typecheck": "pnpm -r typecheck",
    "//": "https://www.prisma.io/docs/orm/more/help-and-troubleshooting/vercel-caching-issue",
    "migrate:postgres": "dotenv -e .env.production -- pnpm --filter @local/{{cookiecutter.db_package_name}} db:deploy",
    "checks": "pnpm lint && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "next": "15.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@next/eslint-plugin-next": "^15.3.2",
    "@tka85/dotenvenc": "^5.4.2",
    "@types/aws-lambda": "^8.10.149",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.26.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5",
    "typescript-eslint": "^8.32.1"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": "eslint --cache --fix",
    "*.{js,css,md}": "prettier --write"
  }
}
