{% raw -%}
#!/usr/bin/env just --justfile

#export PATH := join(justfile_directory(), "node_modules", "bin") + ":" + env_var('PATH')

#build:
#  npm run build

unexport OPENAI_API_KEY

_default:
    just --list

dev:
    pnpm dev

prisma-migrate NAME:
    pnpx dotenv-cli -e .env.development prisma migrate dev --name "{{NAME}}"

# Encrypt environment files using dotenvenc
encrypt-staging:
    pnpx @tka85/dotenvenc -e -i .env.staging -o .env.staging.enc ${DOTENVENC_PASS:?DOTENVENC_PASS is required}

encrypt-production:
    pnpx @tka85/dotenvenc -e -i .env.production -o .env.production.enc ${DOTENVENC_PASS:?DOTENVENC_PASS is required}

# Decrypt environment files for local testing
decrypt-staging:
    pnpx @tka85/dotenvenc -d -i .env.staging.enc -o .env.staging.decrypted ${DOTENVENC_PASS:?DOTENVENC_PASS is required}

decrypt-production:
    pnpx @tka85/dotenvenc -d -i .env.production.enc -o .env.production.decrypted ${DOTENVENC_PASS:?DOTENVENC_PASS is required}

{%- endraw %}