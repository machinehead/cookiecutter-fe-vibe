{
  "name": "@local/shared",
  "version": "1.0.0",
  "description": "Shared database and types",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./prisma": {
      "types": "./dist/src/prisma.d.ts",
      "import": "./dist/src/prisma.js"
    },
    "./zod": {
      "types": "./dist/src/zod.d.ts",
      "import": "./dist/src/zod.js"
    }
  },
  "scripts": {
    "build": "tsc && cp -r src/generated dist/src/",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --watch",
    "db:generate": "dotenv -e ../../.env.staging prisma generate --sql",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/openai": "1.3.22",
    "@ilyanekhay/ai-plumbing": "^3.0.1",
    "@opentelemetry/instrumentation-aws-lambda": "^0.53.0",
    "@opentelemetry/resources": "^2.0.1",
    "@opentelemetry/semantic-conventions": "^1.34.0",
    "@prisma/adapter-neon": "^6.8.2",
    "@prisma/client": "^6.1.0",
    "@prisma/instrumentation": "^6.10.0",
    "ai": "^4.3.16",
    "dedent": "^1.6.0",
    "prisma": "^6.1.0",
    "zod": "^3.24.1",
    "zod-prisma-types": "^3.2.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^22",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.8.3"
  }
}
